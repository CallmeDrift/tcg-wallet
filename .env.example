# URL of this repository's server. For a physical device use your LAN IP,
# for example: http://192.168.1.20:8787
EXPO_PUBLIC_COLLECTION_API_URL=http://localhost:8787

# Used only by `npm run server`; never commit a real token.
COLLECTR_COLLECTION_ID=your-collection-id
COLLECTR_TOKEN=your-revocable-collectr-token
CLIENT_ORIGIN=*
